{# MyInvoice.cz — PDF šablona faktury (Fakturoid-like, mPDF + Twig) #}
{# Variables: invoice (full hydrated), supplier, client, bank, qr_data_uri, locale #}
<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<title></title>
<style>{{ css|raw }}</style>
</head>
<body>

{# Currency display: CZK → "Kč" jako Fakturoid #}
{% set ccy = invoice.currency == 'CZK' ? 'Kč' : invoice.currency %}
{# Datum format — Fakturoid používá "DD. MM. YYYY" s leading zeros #}
{% set date_fmt = locale == 'en' ? 'M j, Y' : 'd. m. Y' %}

{# Title rozdělíme — doc_type_label může být "Faktura — daňový doklad" #}
{% set _dt_parts = doc_type_label|split(' — ') %}
{% set title_word = _dt_parts[0]|default(doc_type_label) %}
{% set title_subtitle = _dt_parts[1]|default('') %}

{# ─── HLAVIČKA ─── #}
<table class="head{% if invoice.invoice_type == 'credit_note' %} credit-note{% elseif invoice.invoice_type == 'cancellation' %} cancellation{% endif %}" cellspacing="0" cellpadding="0">
  <tr>
    <td class="logo">
      {% if logo_path and logo_path is not empty %}
        <img src="{{ logo_path }}" alt="logo">
      {% else %}
        <div class="brand-name">{{ supplier.company_name }}</div>
      {% endif %}
    </td>
    <td class="meta">
      <h1 class="invoice-title">
        <span>{{ title_word }}</span>
        {% if invoice.varsymbol %}
          <span class="number">{{ invoice.varsymbol }}</span>
        {% endif %}
      </h1>
      {% if title_subtitle %}
        <p class="doc-subtitle">{{ title_subtitle }}</p>
      {% endif %}
      {% if parent_varsymbol %}
        <p class="parent-ref">{{ t('k faktuře', 'to invoice') }} {{ parent_varsymbol }}</p>
      {% endif %}
    </td>
  </tr>
</table>

{# ─── STRANY (dodavatel / odběratel) ─── #}
<table class="parties" cellspacing="0" cellpadding="0">
  <tr>
    <td class="party-left">
      <table class="subject-title-line"><tr><td>&nbsp;</td></tr></table>
      <div class="party-title">{{ t('Dodavatel', 'Supplier')|upper }}</div>
      <div class="party-name">{{ supplier.company_name }}</div>
      {% if supplier.display_name and supplier.display_name != supplier.company_name %}
        <div class="party-name-alt">{{ supplier.display_name }}</div>
      {% endif %}
      <div class="party-address">
        {{ supplier.street }}<br>
        {{ supplier.zip }}&nbsp;{{ supplier.city }}<br>
        {{ locale == 'en' ? supplier.country_name_en : supplier.country_name_cs }}
      </div>
      <table class="kv">
        {% if supplier.ic %}
        <tr>
          <td class="kv-lbl">{{ t('IČO', 'Reg. No.') }}</td>
          <td class="kv-val">{{ supplier.ic }}</td>
        </tr>
        {% endif %}
        {% if supplier.dic %}
        <tr>
          <td class="kv-lbl">{{ t('DIČ', 'VAT ID') }}</td>
          <td class="kv-val">{{ supplier.dic }}</td>
        </tr>
        {% endif %}
      </table>
    </td>
    <td class="party-right">
      <table class="subject-title-line"><tr><td>&nbsp;</td></tr></table>
      <div class="party-title">{{ t('Odběratel', 'Customer')|upper }}</div>
      <div class="party-name">{{ client.company_name }}</div>
      {% if client.first_name or client.last_name %}
        <div class="party-name-alt">{{ client.first_name }} {{ client.last_name }}</div>
      {% endif %}
      <div class="party-address">
        {{ client.street }}<br>
        {{ client.zip }}&nbsp;{{ client.city }}<br>
        {{ locale == 'en' ? client.country_name_en : client.country_name_cs }}
      </div>
      <table class="kv">
        {% if client.ic %}
        <tr>
          <td class="kv-lbl">{{ t('IČO', 'Reg. No.') }}</td>
          <td class="kv-val">{{ client.ic }}</td>
        </tr>
        {% endif %}
        {% if client.dic %}
        <tr>
          <td class="kv-lbl">{{ t('DIČ', 'VAT ID') }}</td>
          <td class="kv-val">{{ client.dic }}</td>
        </tr>
        {% endif %}
      </table>
    </td>
  </tr>
</table>

{# ─── METADATA (banka / data) ─── #}
<table class="parties meta-block-wrap" cellspacing="0" cellpadding="0">
  <tr>
    <td class="party-left">
      <table class="kv-tight">
        {% if bank and bank.account_number %}
        <tr>
          <td class="kv-lbl">{{ t('Bankovní účet', 'Bank account') }}</td>
          <td class="kv-val">{{ bank.account_number }}{% if bank.bank_code %}/{{ bank.bank_code }}{% endif %}</td>
        </tr>
        {% endif %}
        {% if bank and bank.iban %}
        <tr>
          <td class="kv-lbl">IBAN</td>
          <td class="kv-val">{{ bank.iban }}</td>
        </tr>
        {% endif %}
        {% if bank and bank.bic %}
        <tr>
          <td class="kv-lbl">BIC / SWIFT</td>
          <td class="kv-val">{{ bank.bic }}</td>
        </tr>
        {% endif %}
        {% if invoice.varsymbol %}
        <tr>
          <td class="kv-lbl">{{ t('Variabilní symbol', 'Variable symbol') }}</td>
          <td class="kv-val">{{ invoice.varsymbol }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="kv-lbl">{{ t('Způsob platby', 'Payment method') }}</td>
          <td class="kv-val">{{ t('Převodem', 'Bank transfer') }}</td>
        </tr>
      </table>
    </td>
    <td class="party-right">
      <table class="kv-tight">
        {% if invoice.project_number %}
        <tr>
          <td class="kv-lbl">{{ t('Číslo objednávky', 'Order number') }}</td>
          <td class="kv-val">{{ invoice.project_number }}</td>
        </tr>
        {% endif %}
        {% if invoice.contract_number %}
        <tr>
          <td class="kv-lbl">{{ t('Číslo smlouvy', 'Contract number') }}</td>
          <td class="kv-val">{{ invoice.contract_number }}</td>
        </tr>
        {% endif %}
        {% if invoice.project_name %}
        <tr>
          <td class="kv-lbl">{{ t('Zakázka', 'Project') }}</td>
          <td class="kv-val">{{ invoice.project_name }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="kv-lbl">{{ t('Datum vystavení', 'Issue date') }}</td>
          <td class="kv-val">{{ invoice.issue_date|date(date_fmt) }}</td>
        </tr>
        <tr>
          <td class="kv-lbl">{{ t('Datum splatnosti', 'Due date') }}</td>
          <td class="kv-val">{{ invoice.due_date|date(date_fmt) }}</td>
        </tr>
        {% if supplier.is_vat_payer and invoice.tax_date and invoice.invoice_type != 'proforma' %}
        <tr>
          <td class="kv-lbl">{{ t('Datum zdan. plnění', 'Tax point date') }}</td>
          <td class="kv-val">{{ invoice.tax_date|date(date_fmt) }}</td>
        </tr>
        {% endif %}
      </table>
    </td>
  </tr>
</table>

{% if invoice.note_above_items %}
<div class="invoice-note">{{ invoice.note_above_items|nl2br }}</div>
{% endif %}

{# ─── POLOŽKY ─── #}
{% set show_qty = invoice.items|filter(it => (it.quantity|default(1)) != 1)|length > 0 %}
{% set show_unit = invoice.items|filter(it => it.unit)|length > 0 %}
{% set show_vat = supplier.is_vat_payer %}
<table class="items">
  <thead>
    <tr>
      <th class="lbl-left" style="width:{% if show_qty and show_unit %}38%{% elseif show_qty or show_unit %}45%{% else %}55%{% endif %}">{{ t('Popis', 'Description') }}</th>
      {% if show_qty %}<th class="nowrap" style="width:8%">{{ t('Mn.', 'Qty') }}</th>{% endif %}
      {% if show_unit %}<th class="lbl-left nowrap" style="width:7%">{{ t('Jed.', 'Unit') }}</th>{% endif %}
      {% if show_qty %}<th class="nowrap" style="width:13%">{{ t('Cena/j', 'Price/unit') }}</th>{% endif %}
      {% if show_vat %}
        <th class="lbl-center nowrap" style="width:8%">{{ t('DPH', 'VAT') }}</th>
        <th class="nowrap" style="width:15%">{{ t('Cena', 'Price') }}</th>
        <th class="nowrap" style="width:17%">{{ t('Celkem s DPH', 'Total incl. VAT') }}</th>
      {% else %}
        <th class="nowrap" style="width:25%">{{ t('Celkem', 'Total') }}</th>
      {% endif %}
    </tr>
  </thead>
  <tbody>
    {% for item in invoice.items %}
    <tr>
      <td>{{ item.description|nl2br }}</td>
      {% if show_qty %}<td class="num nowrap">{{ item.quantity|number_format(item.quantity == item.quantity|round(0) ? 0 : 3, decimal_sep, thousand_sep) }}</td>{% endif %}
      {% if show_unit %}<td class="nowrap">{{ item.unit }}</td>{% endif %}
      {% if show_qty %}<td class="num nowrap">{{ item.unit_price_without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>{% endif %}
      {% if show_vat %}
        <td class="center nowrap">{{ item.vat_rate_snapshot|number_format(item.vat_rate_snapshot == item.vat_rate_snapshot|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
        <td class="num nowrap">{{ item.total_without_vat|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
        <td class="num nowrap">{{ item.total_with_vat|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
      {% else %}
        <td class="num nowrap">{{ item.total_with_vat|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if invoice.reverse_charge and supplier.is_vat_payer %}
<div class="note rc-note">
  {{ t('Daň odvede zákazník (přenesená daňová povinnost dle § 92a zákona o DPH).',
       'Reverse charge — VAT to be accounted for by the customer.') }}
</div>
{% endif %}

{# ─── SUMACE + QR ─── #}
<table class="totals-row" cellspacing="0" cellpadding="0">
  <tr>
    <td class="t-left">
      {% if qr_data_uri %}
      <div class="qr-box">
        <img src="{{ qr_data_uri }}" alt="QR" width="160" height="160">
        <div class="qr-label">{{ t('QR Platba', 'QR payment') }}</div>
      </div>
      {% endif %}
    </td>
    <td class="t-right">
      {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' and invoice.vat_breakdown|length > 0 %}
      <table class="tax-summary">
        <thead>
          <tr>
            <th class="first">{{ t('Sazba', 'Rate') }}</th>
            <th>{{ t('Základ', 'Base') }}</th>
            <th>{{ t('DPH', 'VAT') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for b in invoice.vat_breakdown %}
          <tr>
            <td class="first nowrap">{{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
            <td class="nowrap">{{ b.base|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
            <td class="nowrap">{{ b.vat|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <table class="invoice-total" cellspacing="0" cellpadding="0">
        <tr>
          <td class="total-amount nowrap">{{ invoice.totals.with_vat|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
        </tr>
      </table>

      {% if invoice.advance_paid_amount > 0 %}
      <table class="to-pay-table" cellspacing="0" cellpadding="0">
        <tr class="advance-row">
          <td class="to-pay-lbl">{{ t('Odečet zálohy', 'Advance deduction') }}</td>
          <td class="to-pay-val nowrap">−{{ invoice.advance_paid_amount|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
        </tr>
        <tr class="to-pay-row">
          <td class="to-pay-lbl">{{ t('K úhradě', 'Amount due') }}</td>
          <td class="to-pay-val to-pay-amount nowrap">{{ invoice.amount_to_pay|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
        </tr>
      </table>
      {% endif %}

      {% if invoice.czk_recap %}
      <div class="cnb-rate">
        {{ t('Kurz ČNB', 'CNB rate') }}:
        {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }}
        ({{ invoice.czk_recap.rate_date }})
      </div>
      {% endif %}
    </td>
  </tr>
</table>

{% if invoice.czk_recap %}
<table class="czk-recap">
  <tr>
    <td colspan="2" class="czk-recap-title">
      {{ t('Přepočet do CZK', 'Conversion to CZK') }}
      <span class="czk-recap-rate">
        {{ t('kurz ČNB', 'CNB rate') }}:
        {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }}
        ({{ invoice.czk_recap.rate_date }})
      </span>
    </td>
  </tr>
  {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' %}
  {% for b in invoice.czk_recap.breakdown %}
  <tr>
    <td class="tot-label">{{ t('Základ', 'Base') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
    <td class="tot-num nowrap">{{ b.base_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% if b.vat_czk > 0 %}
  <tr>
    <td class="tot-label">{{ t('DPH', 'VAT') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
    <td class="tot-num nowrap">{{ b.vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% endif %}
  {% endfor %}
  <tr class="subtotal">
    <td class="tot-label">{{ t('Celkem bez DPH', 'Total without VAT') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_without_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  <tr class="subtotal">
    <td class="tot-label">{{ t('DPH celkem', 'Total VAT') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
  {% endif %}
  <tr class="grand">
    <td class="tot-label">{{ t('Celkem', 'Total') }}</td>
    <td class="tot-num nowrap">{{ invoice.czk_recap.total_with_vat_czk|number_format(2, decimal_sep, thousand_sep) }} CZK</td>
  </tr>
</table>
{% endif %}

{% if invoice.note_below_items %}
<div class="note">{{ invoice.note_below_items|nl2br }}</div>
{% endif %}

{% if invoice.invoice_type == 'proforma' %}
<div class="note proforma-note">
  {{ t('Nejedná se o daňový doklad, ten bude vystaven po připsání platby.',
       'This is not a tax document. The tax document will be issued after payment is received.') }}
</div>
{% endif %}

{# ─── Footer ─── #}
<div class="footer-block">
  {% if supplier.commercial_register %}
  <p>{{ supplier.commercial_register }}</p>
  {% endif %}
  {% if supplier.web or supplier.email %}
  <p>
    {% if supplier.web %}{{ t('Web', 'Web') }}: {{ supplier.web }}{% endif %}
    {% if supplier.web and supplier.email %} · {% endif %}
    {% if supplier.email %}{{ t('E-mail', 'E-mail') }}: {{ supplier.email }}{% endif %}
  </p>
  {% endif %}
</div>

{# ─── VÝKAZ VÍCEPRACÍ — 2. stránka ─── #}
{% if work_report %}
{% set wr_has_dates = (work_report.items|filter(it => it.work_date)|length) > 0 %}
<div class="page-break"></div>

<table class="head" cellspacing="0" cellpadding="0">
  <tr>
    <td class="logo">
      {% if logo_path and logo_path is not empty %}
        <img src="{{ logo_path }}" alt="logo">
      {% else %}
        <div class="brand-name">{{ supplier.company_name }}</div>
      {% endif %}
    </td>
    <td class="meta">
      <h1 class="invoice-title">
        <span>{{ t('Výkaz víceprací', 'Work report') }}</span>
      </h1>
      {% if invoice.varsymbol %}
        <p class="doc-subtitle">{{ t('K faktuře', 'For invoice') }} {{ invoice.varsymbol }}</p>
      {% endif %}
    </td>
  </tr>
</table>

<div class="wr-title">{{ work_report.title }}</div>
<div class="wr-meta">
  {% if invoice.project_name %}{{ t('Zakázka', 'Project') }}: {{ invoice.project_name }}{% endif %}
</div>

<table class="items">
  <thead>
    <tr>
      <th class="lbl-left" style="width:{% if wr_has_dates %}43%{% else %}55%{% endif %}">{{ t('Popis', 'Description') }}</th>
      {% if wr_has_dates %}<th class="lbl-left nowrap" style="width:12%">{{ t('Datum', 'Date') }}</th>{% endif %}
      <th class="nowrap" style="width:13%">{{ t('Hodiny', 'Hours') }}</th>
      <th class="nowrap" style="width:14%">{{ t('Sazba', 'Rate') }}</th>
      <th class="nowrap" style="width:18%">{{ t('Celkem', 'Total') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for it in work_report.items %}
    <tr>
      <td>{{ it.description|nl2br }}</td>
      {% if wr_has_dates %}<td class="nowrap">{% if it.work_date %}{{ it.work_date|date(date_fmt) }}{% endif %}</td>{% endif %}
      <td class="num nowrap">{{ it.hours|number_format(2, decimal_sep, thousand_sep) }}</td>
      <td class="num nowrap">{{ it.rate|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
      <td class="num nowrap">{{ it.total_amount|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
    </tr>
    {% endfor %}
    <tr class="wr-total-row">
      <td class="num" {% if wr_has_dates %}colspan="2"{% endif %}>{{ t('Celkem', 'Total') }}</td>
      <td class="num nowrap">{{ work_report.total_hours|number_format(2, decimal_sep, thousand_sep) }}&nbsp;h</td>
      <td></td>
      <td class="num nowrap">{{ work_report.total_amount|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ ccy }}</td>
    </tr>
  </tbody>
</table>

<div class="footer-block">
  {% if supplier.commercial_register %}
  <p>{{ supplier.commercial_register }}</p>
  {% endif %}
  {% if supplier.web or supplier.email %}
  <p>
    {% if supplier.web %}{{ t('Web', 'Web') }}: {{ supplier.web }}{% endif %}
    {% if supplier.web and supplier.email %} · {% endif %}
    {% if supplier.email %}{{ t('E-mail', 'E-mail') }}: {{ supplier.email }}{% endif %}
  </p>
  {% endif %}
</div>
{% endif %}

</body>
</html>
